

# ── Artillery load tests ──────────────────────────────────────────────────────
TARGET_URL=http://<host>:<port>
AUTH_TOKEN=<your_bearer_token>
SPECIES=human   # Options: all | human | fly

# Optional: override the Socket.IO completion timeout (default: 2400000 ms = 40 min)
# COMPLETION_TIMEOUT_MS=2400000

# ── Docker Compose for the Annotation Service(infrastructure) ──────────────────────────────────────────
# APP_PORT=5011
# MONGO_URI=mongodb://localhost:27017/annotation
# MORK_URL=http://<mork-host>:<mork-port>
# MONGODB_DOCKER_PORT=27017
# CADDY_PORT=80
# CADDY_PORT_FORWARD=80
